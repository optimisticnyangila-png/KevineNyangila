{
    "name": "flowpost-backend",
    "version": "1.0.0",
    "description": "Backend for FlowPost social media automation platform",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --runInBand",
        "migrate": "node migrate.js",
        "migrate:status": "node migrate.js status",
        "migrate:rollback": "node migrate.js rollback"
    },
    "dependencies": {
        "@google-cloud/storage": "^7.19.0",
        "axios": "^1.15.2",
        "bcryptjs": "^2.4.3",
        "bull": "^4.16.5",
        "cloudinary": "^2.9.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "ffmpeg-static": "^5.2.0",
        "firebase": "^12.11.0",
        "firebase-admin": "^13.8.0",
        "fluent-ffmpeg": "^2.1.2",
        "googleapis": "^171.4.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^7.5.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.7",
        "socket.io": "^4.8.3",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.1.14",
        "supertest": "^6.3.3"
    },
    "overrides": {
        "gaxios": "^7.1.4",
        "retry-request": "^8.0.2",
        "teeny-request": "^10.1.2",
        "uuid": "^14.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "setupFiles": [
            "<rootDir>/tests/setupEnv.js"
        ],
        "testMatch": [
            "**/*.test.js"
        ]
    }
}
